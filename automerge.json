{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Safe automerge rules preset for juftin repositories",
  "packageRules": [
    {
      "description": "Auto-merge GitHub Actions updates after 3 days",
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "branch",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "minimumReleaseAge": "3 days",
      "ignoreTests": false
    },
    {
      "description": "Auto-merge pre-commit hook updates after 3 days",
      "matchManagers": ["pre-commit"],
      "automerge": true,
      "automergeType": "branch",
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "3 days",
      "ignoreTests": false
    },
    {
      "description": "Auto-merge Mise updates after 3 days",
      "matchManagers": ["mise"],
      "automerge": true,
      "automergeType": "branch",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "minimumReleaseAge": "3 days",
      "ignoreTests": false
    }
  ]
}
