{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Inherits the runner's shared defaults; adds PR automerge for this repository",
  "packageRules": [
    {
      "description": "Auto-merge GitHub Actions updates after 14 days",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "minimumReleaseAge": "14 days",
      "ignoreTests": false
    },
    {
      "description": "Auto-merge pre-commit hook updates after 14 days",
      "matchManagers": [
        "pre-commit"
      ],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "14 days",
      "ignoreTests": false
    }
  ]
}
