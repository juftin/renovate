{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Default Renovate configuration with Conventional Commits",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "docker:pinDigests",
    ":configMigration",
    ":pinDevDependencies",
    ":enablePreCommit",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":semanticCommits"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "packageRules": [
    {
      "description": "Conventional commit prefix for major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "semanticCommitType": "feat",
      "commitMessageExtra": "( {{currentVersion}} → {{newVersion}} )",
      "labels": [
        "type/major"
      ]
    },
    {
      "description": "Conventional commit prefix for minor updates",
      "matchUpdateTypes": [
        "minor"
      ],
      "semanticCommitType": "feat",
      "commitMessageExtra": "( {{currentVersion}} → {{newVersion}} )",
      "labels": [
        "type/minor"
      ]
    },
    {
      "description": "Conventional commit prefix for patch updates",
      "matchUpdateTypes": [
        "patch"
      ],
      "semanticCommitType": "fix",
      "commitMessageExtra": "( {{currentVersion}} → {{newVersion}} )",
      "labels": [
        "type/patch"
      ]
    },
    {
      "description": "Conventional commit prefix for digest updates",
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "semanticCommitType": "chore",
      "commitMessageExtra": "( {{currentDigestShort}} → {{newDigestShort}} )",
      "labels": [
        "type/digest"
      ]
    },
    {
      "description": "Conventional commit prefix for pin updates",
      "matchUpdateTypes": [
        "pin"
      ],
      "semanticCommitType": "chore",
      "commitMessageExtra": "( {{newVersion}} )",
      "labels": [
        "type/pin"
      ]
    },
    {
      "description": "Conventional commit prefix for lockfile maintenance",
      "matchUpdateTypes": [
        "lockFileMaintenance",
        "lockfileUpdate"
      ],
      "semanticCommitType": "chore",
      "labels": [
        "type/lockfile"
      ]
    },
    {
      "description": "Conventional commit prefix and scope for GitHub Actions",
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": "github-action",
      "commitMessageTopic": "action {{depName}}"
    },
    {
      "description": "Conventional commit prefix for bump and replacement updates",
      "matchUpdateTypes": [
        "bump",
        "replacement",
        "rollback"
      ],
      "semanticCommitType": "chore"
    },
    {
      "description": "Label and scope Docker container dependencies",
      "matchDatasources": [
        "docker"
      ],
      "semanticCommitScope": "container",
      "commitMessageTopic": "image {{depName}}",
      "addLabels": [
        "renovate/container"
      ]
    },
    {
      "description": "Label and scope Helm chart dependencies",
      "matchDatasources": [
        "helm"
      ],
      "semanticCommitScope": "helm",
      "commitMessageTopic": "chart {{depName}}",
      "addLabels": [
        "renovate/helm"
      ]
    },
    {
      "description": "Label and scope GitHub Actions dependencies",
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitScope": "github-action",
      "commitMessageTopic": "action {{depName}}",
      "addLabels": [
        "renovate/github-action"
      ]
    },
    {
      "description": "Label and scope GitHub Release dependencies",
      "matchDatasources": [
        "github-releases"
      ],
      "semanticCommitScope": "github-release",
      "commitMessageTopic": "release {{depName}}",
      "addLabels": [
        "renovate/github-release"
      ]
    },
    {
      "description": "Label and scope Mise tool versions",
      "matchManagers": [
        "mise"
      ],
      "semanticCommitScope": "mise",
      "commitMessageTopic": "tool {{depName}}",
      "addLabels": [
        "renovate/mise"
      ]
    },
    {
      "description": "Label and scope pre-commit hook updates",
      "matchManagers": [
        "pre-commit"
      ],
      "semanticCommitScope": "pre-commit",
      "commitMessageTopic": "hook {{depName}}",
      "addLabels": [
        "renovate/pre-commit"
      ]
    },
    {
      "description": "Label and scope Python / PyPI packages",
      "matchDatasources": [
        "pypi"
      ],
      "semanticCommitScope": "python",
      "commitMessageTopic": "package {{depName}}",
      "addLabels": [
        "renovate/python"
      ]
    },
    {
      "description": "Keep pinning, recovery, and package-manager-controlled updates reviewable without unsupported release-age checks",
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "lockFileMaintenance",
        "lockfileUpdate",
        "bump",
        "replacement",
        "rollback"
      ],
      "minimumReleaseAge": null,
      "automerge": false,
      "prBodyNotes": [
        "Release-age checks do not cover this update. Review pinning and recovery changes manually; configure the package manager cooldown for lockfile resolutions (for uv: [tool.uv] exclude-newer = \"7 days\")."
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Process annotated dependencies (e.g., # renovate: datasource=... depName=...)",
      "managerFilePatterns": [
        "/(^|/).+\\.env(?:\\.j2)?$/",
        "/(^|/).+\\.sh(?:\\.j2)?$/",
        "/(^|/).+\\.ya?ml(?:\\.j2)?$/",
        "/(^|/)Dockerfile.*$/"
      ],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?(?<currentValue>\\S+)",
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+/(?<currentValue>(v|\\d)[^/]+)"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Process OCI image dependencies",
      "managerFilePatterns": [
        "/\\.ya?ml(?:\\.j2)?$/"
      ],
      "matchStrings": [
        "oci://(?<depName>[^:]+):(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 4am on monday"
    ],
    "automerge": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "automerge": false
  }
}
